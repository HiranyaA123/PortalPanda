{
  "name": "marketing-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run build:ssr && node scripts/prerender.mjs",
    "build:ssr": "vite build --ssr src/entry-server.jsx --outDir .ssr-build --logLevel warn",
    "postbuild": "node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "images": "node scripts/generate-images.mjs",
    "audit:css": "node scripts/audit-css-usage.mjs",
    "audit:css:fix": "node scripts/audit-css-usage.mjs --fix"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.7",
    "@babel/traverse": "^7.29.7",
    "@vitejs/plugin-react": "^4.3.1",
    "postcss": "^8.5.19",
    "sharp": "^0.35.3",
    "svgo": "^4.0.2",
    "vite": "^5.4.8"
  }
}
